    <groupId>io.github.nbplugins</groupId>
    <artifactId>netbeans-plugin-kotlin</artifactId>
    <version>0.10.20-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>
  <artifactId>netbeans-plugin-kotlin-intention-utils</artifactId>
  <packaging>jar</packaging>
  <name>Netbeans Plugin Kotlin Intention Utils</name>
  <description>
    Utility classes for K2 intentions and quick-fixes, compiled from submodules/IntellijCommunity:
    - base/util: AbstractKotlinBundle
    - base/resources: KotlinBundle
    - base/psi: PsiLinesUtils, IfThenUtils
    - base/util: GenericPsiUtils (reformat/reformatted)
    - base/analysis-api/analysis-api-utils: shortenUtils, ImportInsertion, KotlinImportPathComparator,
      CallParameterInfoProvider
    - code-insight/impl-base: AddRemainingWhenBranchesUtils, RemoveArgumentNamesUtils, MergeIfsUtils,
      StringTemplateUtils, BuildStringUtils (psi/)
    - code-insight/utils: ConvertLambdaToReferenceUtils, ImplicitThisUtils
    - refactorings/k2: ConvertReferenceToLambdaUtil, LambdaToAnonymousFunctionUtil, BranchedFoldingUtils
    Local stubs: replaced(), copied(), isInsideAnnotationEntryArgumentList(), isToString(),
      KotlinNameSuggester, getReceiverKtType(), moveFunctionLiteralOutsideParenthesesIfPossible(),
      getLastLambdaExpression(), dereferenceValidPointers() for standalone (non-IDE) mode.
  </description>

  <build>
    <!--
      Sources are copied from multiple submodule directories to target/generated-sources/intention-utils/
      so that gmavenplus patches can modify copies without dirtying the git submodule, and so that
      kotlin-maven-plugin can compile from a single <sourceDirectory>.
    -->
    <sourceDirectory>${project.build.directory}/generated-sources/intention-utils</sourceDirectory>

    <plugins>
      <!--
        Copy Kotlin sources from submodule source roots into
        target/generated-sources/intention-utils/, preserving package directory structure.
      -->
