      <!--
        Patch API incompatibilities between IntelliJ-internal code (used by submodule sources)
        and standalone compilation without full IntelliJ IDE on the classpath:

        1. MergeIfsUtils.kt: remove import and usage of findExistingEditor (IDE editor API).
           The caret-position side-effect is omitted; the merge logic still works correctly.
      -->
      <plugin>
        <groupId>org.codehaus.gmavenplus</groupId>
        <artifactId>gmavenplus-plugin</artifactId>
        <executions>
          <execution>
            <id>patch-intention-utils-compat</id>
            <phase>generate-sources</phase>
            <goals><goal>execute</goal></goals>
            <configuration>
              <scripts>
                <script><![CDATA[
import java.nio.file.*

def srcDir = new File(project.build.directory, 'generated-sources/intention-utils')

def patches = [
  // MergeIfsUtils.kt: findExistingEditor() is an IDE-only API for moving the editor caret.
  // Removing both the import and the usage; the merge transformation still works correctly.
  [file: 'org/jetbrains/kotlin/idea/codeinsights/impl/base/inspections/MergeIfsUtils.kt',
   old:  'import org.jetbrains.kotlin.idea.codeinsight.utils.findExistingEditor\n',
   new_: ''],
  [file: 'org/jetbrains/kotlin/idea/codeinsights/impl/base/inspections/MergeIfsUtils.kt',
   old:  '            element.findExistingEditor()?.caretModel?.moveToOffset(element.startOffset)\n',
   new_: ''],
  // MergeIfsUtils.kt: safeAs<KtBlockExpression>() generates an UNCHECKED_CAST compiler error in 2.2.
  // Replace with a regular as? cast wrapped in parentheses to preserve operator precedence.
  [file: 'org/jetbrains/kotlin/idea/codeinsights/impl/base/inspections/MergeIfsUtils.kt',
   old:  'import org.jetbrains.kotlin.utils.addToStdlib.safeAs\n',
   new_: ''],
  [file: 'org/jetbrains/kotlin/idea/codeinsights/impl/base/inspections/MergeIfsUtils.kt',
   old:  'then.safeAs<KtBlockExpression>()',
   new_: '(then as? KtBlockExpression)'],

  // shortenUtils.kt: allowAnalysisOnEdt/allowAnalysisFromWriteAction are IntelliJ EDT/write-action
  // guards not applicable in standalone (NetBeans) mode; replace with direct analyze {} call.
  [file: 'org/jetbrains/kotlin/idea/base/analysis/api/utils/shortenUtils.kt',
   old:  'import org.jetbrains.kotlin.analysis.api.permissions.KaAllowAnalysisFromWriteAction\n',
   new_: ''],
  [file: 'org/jetbrains/kotlin/idea/base/analysis/api/utils/shortenUtils.kt',
   old:  'import org.jetbrains.kotlin.analysis.api.permissions.KaAllowAnalysisOnEdt\n',
   new_: ''],
  [file: 'org/jetbrains/kotlin/idea/base/analysis/api/utils/shortenUtils.kt',
   old:  'import org.jetbrains.kotlin.analysis.api.permissions.allowAnalysisFromWriteAction\n',
   new_: ''],
  [file: 'org/jetbrains/kotlin/idea/base/analysis/api/utils/shortenUtils.kt',
   old:  'import org.jetbrains.kotlin.analysis.api.permissions.allowAnalysisOnEdt\n',
   new_: ''],
  [file: 'org/jetbrains/kotlin/idea/base/analysis/api/utils/shortenUtils.kt',
   old:  '@OptIn(KaAllowAnalysisOnEdt::class)\n',
   new_: ''],
  [file: 'org/jetbrains/kotlin/idea/base/analysis/api/utils/shortenUtils.kt',
   old:  '    val shortenCommand = allowAnalysisOnEdt {\n        @OptIn(KaAllowAnalysisFromWriteAction::class)\n        allowAnalysisFromWriteAction {\n            analyze(file) {\n                collectPossibleReferenceShortenings(file, range, shortenOptions, classShortenStrategy, callableShortenStrategy)\n            }\n        }\n    }',
   new_: '    val shortenCommand = analyze(file) {\n        collectPossibleReferenceShortenings(file, range, shortenOptions, classShortenStrategy, callableShortenStrategy)\n    }'],

  // CallParameterInfoProvider.kt: isNotSubTypeOf is an internal extension not in public API;
  // replace with the public isSubtypeOf negated.
  [file: 'org/jetbrains/kotlin/idea/base/analysis/api/utils/CallParameterInfoProvider.kt',
   old:  'argumentType.isNotSubTypeOf(parameterForArgument.returnType, subtypingErrorTypePolicy)',
   new_: '!argumentType.isSubtypeOf(parameterForArgument.returnType, subtypingErrorTypePolicy)'],

  // CallParameterInfoProvider.kt: isJavaSourceOrLibrary() checks KaSymbolOrigin (internal utility).
  // In standalone mode (NetBeans), Java annotation argument detection is not required.
  [file: 'org/jetbrains/kotlin/idea/base/analysis/api/utils/CallParameterInfoProvider.kt',
   old:  '        if (!signature.symbol.origin.isJavaSourceOrLibrary()) return false\n',
   new_: '        return false // isJavaSourceOrLibrary: not applicable in standalone mode\n'],

  // StringTemplateUtils.kt: KaNamedClassOrObjectSymbol was renamed to KaClassSymbol in Analysis API 2.3.21.
  [file: 'org/jetbrains/kotlin/idea/codeinsights/impl/base/StringTemplateUtils.kt',
   old:  'import org.jetbrains.kotlin.analysis.api.symbols.KaNamedClassOrObjectSymbol\n',
   new_: 'import org.jetbrains.kotlin.analysis.api.symbols.KaClassSymbol\n'],
  [file: 'org/jetbrains/kotlin/idea/codeinsights/impl/base/StringTemplateUtils.kt',
   old:  'val classContainingPlus = plusOperation?.containingDeclaration as? KaNamedClassOrObjectSymbol',
   new_: 'val classContainingPlus = plusOperation?.containingDeclaration as? KaClassSymbol'],

  // StringTemplateUtils.kt: isString was renamed to isStringType in Analysis API 2.3.21.
  [file: 'org/jetbrains/kotlin/idea/codeinsights/impl/base/StringTemplateUtils.kt',
   old:  'if (expression.expressionType?.isString != true) return false',
   new_: 'if (expression.expressionType?.isStringType != true) return false'],

  // StringTemplateUtils.kt: ConstantValueKind was removed; KaConstantValue now uses nested interfaces.
  [file: 'org/jetbrains/kotlin/idea/codeinsights/impl/base/StringTemplateUtils.kt',
   old:  'import org.jetbrains.kotlin.types.ConstantValueKind\n',
   new_: ''],
  [file: 'org/jetbrains/kotlin/idea/codeinsights/impl/base/StringTemplateUtils.kt',
   old:  '    val isChar = constantValue.constantValueKind == ConstantValueKind.Char\n  val stringValue = if (isChar) "${constantValue.value}" else constantValue.render()',
   new_: '    val isChar = constantValue is org.jetbrains.kotlin.analysis.api.base.KaConstantValue.CharValue\n    val stringValue = if (isChar) "${(constantValue as org.jetbrains.kotlin.analysis.api.base.KaConstantValue.CharValue).value}" else constantValue.render()'],

  // AnalysisUtilsStubs.kt: isString was renamed to isStringType in Analysis API 2.3.21.
  [file: 'org/jetbrains/kotlin/idea/codeinsight/utils/AnalysisUtilsStubs.kt',
   old:  'functionSymbol.returnType.isString',
   new_: 'functionSymbol.returnType.isStringType'],

  // ConvertReferenceToLambdaUtil.kt: inject getReceiverKtType import (provided by CallableReferenceStubs.kt).
  [file: 'org/jetbrains/kotlin/idea/k2/refactoring/util/ConvertReferenceToLambdaUtil.kt',
   old:  'import org.jetbrains.kotlin.analysis.api.symbols.*\n',
   new_: 'import org.jetbrains.kotlin.analysis.api.symbols.*\nimport org.jetbrains.kotlin.idea.codeinsight.utils.getReceiverKtType\n'],

  // ConvertReferenceToLambdaUtil.kt: KaNamedClassOrObjectSymbol → KaNamedClassSymbol (isInner is on KaNamedClassSymbol in 2.3.21).
  [file: 'org/jetbrains/kotlin/idea/k2/refactoring/util/ConvertReferenceToLambdaUtil.kt',
   old:  'symbol is KaNamedClassOrObjectSymbol && symbol.isInner',
   new_: 'symbol is KaNamedClassSymbol && symbol.isInner'],

  // BranchedFoldingUtils.kt: isNothing → isNothingType in Analysis API 2.3.21.
  // isNothingType is an extension property on KaType in KaSession context.
  [file: 'org/jetbrains/kotlin/idea/k2/refactoring/util/BranchedFoldingUtils.kt',
   old:  'e.expressionType?.isNothing ?: false',
   new_: 'e.expressionType?.isNothingType ?: false'],
  [file: 'org/jetbrains/kotlin/idea/k2/refactoring/util/BranchedFoldingUtils.kt',
   old:  'if (expression.expressionType?.isNothing == true) FoldableReturns(emptyList(), true) else FoldableReturns.NotFoldable',
   new_: 'if (expression.expressionType?.isNothingType == true) FoldableReturns(emptyList(), true) else FoldableReturns.NotFoldable'],
  [file: 'org/jetbrains/kotlin/idea/k2/refactoring/util/BranchedFoldingUtils.kt',
   old:  'if (expression.expressionType?.isNothing == true) emptyList() else null',
   new_: 'if (expression.expressionType?.isNothingType == true) emptyList() else null'],

