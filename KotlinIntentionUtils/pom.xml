            <id>copy-abstract-bundle</id>
            <phase>initialize</phase>
            <goals><goal>copy-resources</goal></goals>
            <configuration>
              <outputDirectory>${project.build.directory}/generated-sources/intention-utils</outputDirectory>
              <overwrite>true</overwrite>
              <resources>
                <resource>
                  <directory>${basedir}/../submodules/IntellijCommunity/plugins/kotlin/base/util/src</directory>
                  <filtering>false</filtering>
                  <includes>
                    <include>org/jetbrains/kotlin/util/AbstractKotlinBundle.kt</include>
                  </includes>
                </resource>
              </resources>
            </configuration>
          </execution>

