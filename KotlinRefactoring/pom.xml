      <!--
        Patch era 253 API incompatibilities in copied submodule sources:
        1. shortenUtils.kt: replace allowAnalysisFromWriteActionInEdt (removed) with analyze {}
        2. base/psi/KotlinPsiUtils.kt: remove ImplementationDetailClassNameCheckerProvider (IDE extension, not on classpath)
        3. ConvertToBlockBodyUtils.kt: wrap String in KtPsiFactory.createType() for setTypeReference(KtTypeReference?)
        4. CodeInliner.kt: remove ExpectActualUtils (not on classpath); simplify getDefaultValue
        5. ClassUsageReplacementStrategy.kt: replace j2k.resolve extension with mainReference.resolve()
      -->
      <plugin>
        <groupId>org.codehaus.gmavenplus</groupId>
        <artifactId>gmavenplus-plugin</artifactId>
        <executions>
          <execution>
            <id>patch-refactoring-sources</id>
            <phase>generate-sources</phase>
            <goals><goal>execute</goal></goals>
            <configuration>
              <scripts>
                <script><![CDATA[
import java.nio.file.*

def srcDir = new File(project.build.directory, 'generated-sources/refactoring')

// 1. shortenUtils.kt: allowAnalysisFromWriteActionInEdt is removed in analysis-api 2.3.21;
//    replace with plain analyze {} which works in write actions under our session model.
def shortenFile = new File(srcDir, 'org/jetbrains/kotlin/idea/base/analysis/api/utils/shortenUtils.kt')
if (shortenFile.exists()) {
  def text = shortenFile.text
  if (text.contains('allowAnalysisFromWriteActionInEdt(file) {')) {
    text = text.replace(
      'allowAnalysisFromWriteActionInEdt(file) {\n    collectPossibleReferenceShortenings(file, selection, shortenOptions, classShortenStrategy, callableShortenStrategy)\n}.invokeShortening()',
      'analyze(file) {\n    collectPossibleReferenceShortenings(file, selection, shortenOptions, classShortenStrategy, callableShortenStrategy)\n}.invokeShortening()'
    )
    if (!text.contains('import org.jetbrains.kotlin.analysis.api.analyze')) {
      text = text.replace('import com.intellij.psi.createSmartPointer\n',
                          'import com.intellij.psi.createSmartPointer\nimport org.jetbrains.kotlin.analysis.api.analyze\n')
    }
    shortenFile.text = text
    log.info("Patched shortenUtils.kt: replaced allowAnalysisFromWriteActionInEdt with analyze")
  }
}

// 2. base/psi/KotlinPsiUtils.kt: remove ImplementationDetailClassNameCheckerProvider
//    (IDE extension point from base/psi/extensions, not available standalone).
//    Replace presentableClassId with a simple delegation to classIdIfNonLocal.
def basePsiUtils = new File(srcDir, 'org/jetbrains/kotlin/idea/base/psi/KotlinPsiUtils.kt')
if (basePsiUtils.exists()) {
  def text = basePsiUtils.text
  text = text.replace('import org.jetbrains.kotlin.idea.base.psi.extensions.ImplementationDetailClassNameCheckerProvider\n', '')
  text = text.replace(
    '''val KtClassOrObject.presentableClassId: ClassId?
    get() {
        if (KtPsiUtil.isLocal(this)) return null
        val packageName = containingKtFile.packageFqName
        val checker = ImplementationDetailClassNameCheckerProvider.get(this)
        val classNames = buildList {
            for (clazz in parentsOfType<KtDeclaration>()) {
                val className = clazz.name
                when {
                    className == null -> return null
                    checker.isImplementationDetail(className) -> continue
                    else -> add(className)
                }
            }
        }
        return ClassId(
            packageFqName = packageName,
            relativeClassName = FqName(classNames.asReversed().joinToString(separator = ".")),
            isLocal = false
        )
    }''',
    'val KtClassOrObject.presentableClassId: ClassId?\n    get() = classIdIfNonLocal'
  )
  basePsiUtils.text = text
  log.info("Patched base/psi/KotlinPsiUtils.kt: simplified presentableClassId")
}

// 3. ConvertToBlockBodyUtils.kt: setTypeReference() now takes KtTypeReference?, not String.
def convertUtils = new File(srcDir, 'org/jetbrains/kotlin/idea/codeinsight/utils/ConvertToBlockBodyUtils.kt')
if (convertUtils.exists()) {
  def text = convertUtils.text
  // In the KtNamedFunction branch, this.project is in scope via smart-cast.
  text = text.replace(
    '                    setTypeReference(context.returnTypeString)',
    '                    setTypeReference(KtPsiFactory(project).createType(context.returnTypeString))'
  )
  // In the KtPropertyAccessor branch, parent is KtProperty.
  text = text.replace(
    '                    parent.setTypeReference(context.returnTypeString)',
    '                    parent.setTypeReference(KtPsiFactory(parent.project).createType(context.returnTypeString))'
  )
  convertUtils.text = text
  log.info("Patched ConvertToBlockBodyUtils.kt: wrapped String in KtPsiFactory.createType() for setTypeReference")
}

// 4. CodeInliner.kt: ExpectActualUtils (IDE-level, not on classpath) used only in getDefaultValue.
//    Remove the imports and simplify getDefaultValue to return parameter.defaultValue directly.
def codeInliner = new File(srcDir, 'org/jetbrains/kotlin/idea/k2/refactoring/inline/codeInliner/CodeInliner.kt')
if (codeInliner.exists()) {
  def text = codeInliner.text
