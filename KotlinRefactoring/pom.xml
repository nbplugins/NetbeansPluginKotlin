<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.github.nbplugins</groupId>
    <artifactId>netbeans-plugin-kotlin</artifactId>
    <version>0.11.97-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>
  <artifactId>netbeans-plugin-kotlin-refactoring</artifactId>
  <packaging>jar</packaging>
  <name>Netbeans Plugin Kotlin Refactoring</name>
  <description>
    K2-based refactoring computers for the NetBeans Kotlin plugin.
    Contains pure analysis logic (no NetBeans UI deps): KaRenameComputer, TextChange,
    and IDEA data structures (KotlinPsiRange, KotlinPsiUnificationResult) compiled from
    submodules/IntellijCommunity/plugins/kotlin/base/psi/src/org/jetbrains/kotlin/idea/base/psi/unifier/.
    Used by the Nbm module for all K2 refactoring operations (rename, safe delete, etc.).
  </description>

  <build>
    <!--
      Sources are assembled from two locations into target/generated-sources/refactoring/:
      1. Local src/main/kotlin/ — KaRenameComputer, TextChange (NetBeans-free K2 logic)
      2. submodules/IntellijCommunity — KotlinPsiRange, KotlinPsiUnificationResult (IDEA data structures)
    -->
    <sourceDirectory>${project.build.directory}/generated-sources/refactoring</sourceDirectory>

    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <executions>
          <!-- Local refactoring computers (KaRenameComputer, TextChange, etc.) -->
          <execution>
            <id>copy-local-sources</id>
            <phase>initialize</phase>
            <goals><goal>copy-resources</goal></goals>
            <configuration>
              <outputDirectory>${project.build.directory}/generated-sources/refactoring</outputDirectory>
              <overwrite>true</overwrite>
              <resources>
                <resource>
                  <directory>${basedir}/src/main/kotlin</directory>
                  <filtering>false</filtering>
                </resource>
              </resources>
            </configuration>
          </execution>
          <!-- IDEA data structures: KotlinPsiRange, KotlinPsiUnificationResult -->
          <execution>
            <id>copy-idea-psi-unifier</id>
            <phase>initialize</phase>
            <goals><goal>copy-resources</goal></goals>
            <configuration>
              <outputDirectory>${project.build.directory}/generated-sources/refactoring</outputDirectory>
              <overwrite>true</overwrite>
              <resources>
                <resource>
                  <directory>${basedir}/../submodules/IntellijCommunity/plugins/kotlin/base/psi/src</directory>
                  <filtering>false</filtering>
                  <includes>
                    <include>org/jetbrains/kotlin/idea/base/psi/unifier/KotlinPsiRange.kt</include>
                    <include>org/jetbrains/kotlin/idea/base/psi/unifier/KotlinPsiUnificationResult.kt</include>
                  </includes>
                </resource>
              </resources>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.jetbrains.kotlin</groupId>
        <artifactId>kotlin-maven-plugin</artifactId>
        <configuration>
          <languageVersion>${kotlin.runtime.languageVersion}</languageVersion>
          <apiVersion>${kotlin.runtime.languageVersion}</apiVersion>
          <jvmTarget>17</jvmTarget>
          <args>
            <arg>-Xskip-metadata-version-check</arg>
            <arg>-opt-in=org.jetbrains.kotlin.analysis.api.KaIdeApi</arg>
          </args>
          <sourceDirs>
            <sourceDir>${project.build.directory}/generated-sources/refactoring</sourceDir>
          </sourceDirs>
        </configuration>
        <executions>
          <execution>
            <id>compile</id>
            <phase>process-sources</phase>
            <goals><goal>compile</goal></goals>
          </execution>
        </executions>
      </plugin>

      <!-- No Java sources in this module — disable the default-compile execution -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <compilerArgument>-proc:none</compilerArgument>
        </configuration>
        <executions>
          <execution>
            <id>default-compile</id>
            <phase>none</phase>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <dependencies>
    <!-- IntelliJ platform: PsiElement, PsiTreeUtil, TextRange, SmartPointerManager, etc. -->
    <dependency>
      <groupId>com.jetbrains.intellij.platform</groupId>
      <artifactId>core</artifactId>
      <version>${intellij.platform.253.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>com.jetbrains.intellij.platform</groupId>
      <artifactId>core-impl</artifactId>
      <version>${intellij.platform.253.version}</version>
      <scope>provided</scope>
    </dependency>

    <!-- PsiClassOwner: supertype of KtFile (needed for KtFile method dispatch) -->
    <dependency>
      <groupId>com.jetbrains.intellij.java</groupId>
      <artifactId>java-psi</artifactId>
      <scope>provided</scope>
    </dependency>

    <!-- Kotlin PSI (KtFile, KtElement, KtTreeVisitorVoid, KtTokens, …) -->
    <dependency>
      <groupId>org.jetbrains.kotlin</groupId>
      <artifactId>kotlin-compiler-ir-for-ide</artifactId>
      <scope>provided</scope>
      <exclusions>
        <exclusion><groupId>*</groupId><artifactId>*</artifactId></exclusion>
      </exclusions>
    </dependency>
    <!-- mainReference, KtReference, KtSimpleNameReference -->
    <dependency>
      <groupId>org.jetbrains.kotlin</groupId>
      <artifactId>kotlin-compiler-common-for-ide</artifactId>
      <scope>provided</scope>
      <exclusions>
        <exclusion><groupId>*</groupId><artifactId>*</artifactId></exclusion>
      </exclusions>
    </dependency>

    <!-- K2 Analysis API: analyze{}, KaCallableSymbol, KaSymbol, etc. -->
    <dependency>
      <groupId>org.jetbrains.kotlin</groupId>
      <artifactId>analysis-api-for-ide</artifactId>
      <scope>provided</scope>
      <exclusions>
        <exclusion><groupId>*</groupId><artifactId>*</artifactId></exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>org.jetbrains.kotlin</groupId>
      <artifactId>analysis-api-impl-base-for-ide</artifactId>
      <scope>provided</scope>
      <exclusions>
        <exclusion><groupId>*</groupId><artifactId>*</artifactId></exclusion>
      </exclusions>
    </dependency>

    <dependency>
      <groupId>org.jetbrains</groupId>
      <artifactId>annotations</artifactId>
      <scope>provided</scope>
    </dependency>
  </dependencies>
</project>
