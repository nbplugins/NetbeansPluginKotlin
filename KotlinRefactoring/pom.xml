// 8. InlinePreprocessorUtil.kt: getKaModule is IDE-only project-structure API.
//    Replace isImportable() with a lightweight PSI-only check (avoids analyze(KaModule)).
def inlinePreprocessorUtil = new File(srcDir, 'org/jetbrains/kotlin/idea/k2/refactoring/inline/codeInliner/InlinePreprocessorUtil.kt')
if (inlinePreprocessorUtil.exists()) {
  def text = inlinePreprocessorUtil.text
  text = text.replace('import org.jetbrains.kotlin.idea.base.projectStructure.getKaModule\n', '')
  def oldIsImportable = '''        fun isImportable(t: PsiElement): Boolean {
            val module = t.getKaModule(t.project, useSiteModule = null)
            return analyze(module) {
                val resolvedSymbol = when (t) {
                    is KtNamedDeclaration -> t.symbol
                    is PsiMember -> {
                        if ((t.containingFile as? PsiJavaFile)?.packageName == CommonClassNames.DEFAULT_PACKAGE) {
                            return@analyze false
                        }
                        if (t is PsiClass) {
                            return@analyze t.qualifiedName != null
                        }
                        t.callableSymbol
                    }
                    else -> null
                } ?: return@analyze false
                if (resolvedSymbol is KaEnumEntrySymbol || resolvedSymbol is KaClassSymbol && resolvedSymbol.containingSymbol is KaClassSymbol) {
                    return@analyze false
                }
                val containingSymbol = resolvedSymbol.containingDeclaration ?: return@analyze true
                if (containingSymbol is KaDeclarationContainerSymbol) {
                    val staticScope = containingSymbol.staticMemberScope
                    return@analyze resolvedSymbol in staticScope.declarations
                }
                return@analyze false
            }
        }'''
  def newIsImportable = '''        fun isImportable(t: PsiElement): Boolean {
            return when (t) {
                is KtNamedDeclaration -> {
                    if (KtPsiUtil.isLocal(t)) return false
                    t.fqName != null
                }
                is PsiMember -> {
                    if ((t.containingFile as? PsiJavaFile)?.packageName == CommonClassNames.DEFAULT_PACKAGE) return false
                    if (t is PsiClass) return t.qualifiedName != null
                    t.containingClass?.qualifiedName != null
                }
                else -> false
            }
        }'''
  text = text.replace(oldIsImportable, newIsImportable)
  inlinePreprocessorUtil.text = text
  log.info("Patched InlinePreprocessorUtil.kt: removed getKaModule, simplified isImportable")
}

